// Payment Agent — Cedar Schema
//
// Server-aligned action model (PreToolUse / ToolOutput / Prompt).
// Typed parameters and response fields are merged from all tools
// into single optional records for local policy evaluation.

namespace payment_agent {
  entity Agent = {
    name: __cedar::String,
    provider: __cedar::String,
    tools: Set<Tool>
  };

  entity Message in [Trajectory] = {
    content: __cedar::String,
    role: Role
  };

  entity Role enum ["user", "model", "system", "tool"];

  entity Tool in [Trajectory] = {
    description: __cedar::String,
    name: __cedar::String
  };

  entity Trajectory = {
    step_count: __cedar::Long
  };

  action "Prompt" appliesTo {
    principal: [Agent],
    resource: [Message]
  };

  action "PreToolUse" appliesTo {
    principal: [Agent],
    resource: [Tool],
    context: {
      tool: __cedar::String,
      arguments: __cedar::String,
      parameters?: {
        // get_customer_profile, get_transactions, initiate_refund
        customer_id?: __cedar::String,
        // get_transactions, initiate_refund
        amount?: __cedar::Long,
        // initiate_refund
        transaction_id?: __cedar::String,
        // send_email
        to?: __cedar::String,
        subject?: __cedar::String,
        body?: __cedar::String
      }
    }
  };

  action "ToolOutput" appliesTo {
    principal: [Agent],
    resource: [Trajectory],
    context: {
      content: __cedar::String,
      response?: {
        // get_customer_profile
        cc_number?: __cedar::String,
        customer_id?: __cedar::String,
        email?: __cedar::String,
        region?: __cedar::String,
        // get_transactions
        value?: Set<{
          amount?: __cedar::Long,
          merchant_name?: __cedar::String,
          transaction_id?: __cedar::String
        }>,
        // initiate_refund
        refunded_amount?: __cedar::Long,
        status?: __cedar::String,
        transaction_id?: __cedar::String,
        // send_email
        body?: __cedar::String,
        subject?: __cedar::String,
        to?: __cedar::String
      }
    }
  };
}
