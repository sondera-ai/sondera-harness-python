// Investment Chatbot — Cedar Schema
//
// Server-aligned action model (PreToolUse / ToolOutput / Prompt).
// Typed parameters and response fields are merged from all tools
// into single optional records for local policy evaluation.

namespace investment_chatbot {
  entity Agent = {
    name: __cedar::String,
    provider: __cedar::String,
    tools: Set<Tool>
  };

  entity Message in [Trajectory] = {
    content: __cedar::String,
    role: Role
  };

  entity Role enum ["user", "model", "system", "tool"];

  entity Tool in [Trajectory] = {
    description: __cedar::String,
    name: __cedar::String
  };

  entity Trajectory = {
    step_count: __cedar::Long
  };

  action "Prompt" appliesTo {
    principal: [Agent],
    resource: [Message]
  };

  // PreToolUse — fires before any tool invocation.
  // context.tool and context.arguments are server-compatible.
  // context.parameters merges typed fields from all tools (local-only extension).
  action "PreToolUse" appliesTo {
    principal: [Agent],
    resource: [Tool],
    context: {
      tool: __cedar::String,
      arguments: __cedar::String,
      parameters?: {
        // get_account_info, get_portfolio, make_trade_recommendation, send_notification
        customer_id?: __cedar::String,
        // get_stock_quote, get_market_news, make_trade_recommendation
        symbol?: __cedar::String,
        // make_trade_recommendation
        action?: __cedar::String,
        shares?: __cedar::Long,
        // send_notification
        message?: __cedar::String,
        subject?: __cedar::String
      }
    }
  };

  // ToolOutput — fires after tool execution.
  // context.content is server-compatible (JSON string of the full response).
  // context.response merges typed fields from all tools (local-only extension).
  action "ToolOutput" appliesTo {
    principal: [Agent],
    resource: [Trajectory],
    context: {
      content: __cedar::String,
      response?: {
        // get_account_info
        account_id?: __cedar::String,
        account_number?: __cedar::String,
        account_status?: __cedar::String,
        account_type?: __cedar::String,
        customer_id?: __cedar::String,
        email?: __cedar::String,
        error?: __cedar::String,
        investment_objectives?: Set<__cedar::String>,
        name?: __cedar::String,
        region?: __cedar::String,
        risk_tolerance?: __cedar::String,
        ssn?: __cedar::String,
        // get_market_news
        news?: Set<{
          headline?: __cedar::String,
          message?: __cedar::String,
          published?: __cedar::String,
          sentiment?: __cedar::String,
          source?: __cedar::String
        }>,
        // get_portfolio
        cash_balance?: __cedar::Long,
        holdings?: Set<{
          cost_basis?: __cedar::Long,
          current_price?: __cedar::Long,
          gain_loss?: __cedar::Long,
          market_value?: __cedar::Long,
          shares?: __cedar::Long,
          symbol?: __cedar::String
        }>,
        total_value?: __cedar::Long,
        // get_stock_quote
        aum?: __cedar::String,
        change?: __cedar::Long,
        change_percent?: __cedar::Long,
        day_high?: __cedar::Long,
        day_low?: __cedar::Long,
        dividend_yield?: __cedar::Long,
        expense_ratio?: __cedar::Long,
        market_cap?: __cedar::String,
        pe_ratio?: __cedar::Long,
        price?: __cedar::Long,
        symbol?: __cedar::String,
        volume?: __cedar::Long,
        // make_trade_recommendation
        action?: __cedar::String,
        disclaimer?: __cedar::String,
        reasoning?: __cedar::String,
        recommendation_id?: __cedar::String,
        recommended_price?: __cedar::Long,
        requires_approval?: __cedar::Bool,
        risk_score?: __cedar::String,
        shares?: __cedar::Long,
        status?: __cedar::String,
        // send_notification
        channel?: __cedar::String,
        notification_id?: __cedar::String
      }
    }
  };
}
