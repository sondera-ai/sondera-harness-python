namespace claude_code {
  entity Agent = {
    name: __cedar::String,
    provider: __cedar::String
  };

  entity Tool in [Trajectory] = {
    name: __cedar::String,
    description: __cedar::String
  };

  entity Trajectory = {
    step_count: __cedar::Long
  };

  action "PreToolUse" appliesTo {
    principal: [Agent],
    resource: [Tool],
    context: {
      tool: __cedar::String,
      arguments: __cedar::String,
      // Local-only typed extension for parameter constraints
      parameters?: {
        permission_mode?: __cedar::String,
        file_path?: __cedar::String,
        content?: __cedar::String,
        old_string?: __cedar::String,
        new_string?: __cedar::String,
        replace_all?: __cedar::Bool,
        is_plan_file?: __cedar::Bool
      }
    }
  };

  action "ToolOutput" appliesTo {
    principal: [Agent],
    resource: [Trajectory],
    context: {
      content: __cedar::String
    }
  };
}
