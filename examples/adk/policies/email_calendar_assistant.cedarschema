// Email & Calendar Assistant — Cedar Schema
//
// Server-aligned action model (PreToolUse / ToolOutput / Prompt).
// Typed parameters and response fields are merged from all tools
// into single optional records for local policy evaluation.

namespace email_calendar_assistant {
  entity Agent = {
    name: __cedar::String,
    provider: __cedar::String,
    tools: Set<Tool>
  };

  entity Message in [Trajectory] = {
    content: __cedar::String,
    role: Role
  };

  entity Role enum ["user", "model", "system", "tool"];

  entity Tool in [Trajectory] = {
    description: __cedar::String,
    name: __cedar::String
  };

  entity Trajectory = {
    step_count: __cedar::Long
  };

  action "Prompt" appliesTo {
    principal: [Agent],
    resource: [Message]
  };

  action "PreToolUse" appliesTo {
    principal: [Agent],
    resource: [Tool],
    context: {
      tool: __cedar::String,
      arguments: __cedar::String,
      parameters?: {
        // get_unread_emails, get_calendar_events
        user_id?: __cedar::String,
        // get_calendar_events
        date?: __cedar::String,
        // create_calendar_event
        title?: __cedar::String,
        start_time?: __cedar::String,
        end_time?: __cedar::String,
        location?: __cedar::String,
        attendees?: Set<__cedar::String>,
        // send_email
        to?: __cedar::String,
        subject?: __cedar::String,
        body?: __cedar::String
      }
    }
  };

  action "ToolOutput" appliesTo {
    principal: [Agent],
    resource: [Trajectory],
    context: {
      content: __cedar::String,
      response?: {
        // get_unread_emails
        value?: Set<{
          body?: __cedar::String,
          id?: __cedar::String,
          received_at?: __cedar::String,
          sender?: __cedar::String,
          subject?: __cedar::String
        }>,
        // create_calendar_event
        event_id?: __cedar::String,
        start_time?: __cedar::String,
        status?: __cedar::String,
        title?: __cedar::String,
        // get_calendar_events uses 'value' (same field, different shape —
        // Cedar validates structurally; the Set element type covers both)
        // send_email
        message_id?: __cedar::String,
        subject?: __cedar::String,
        to?: __cedar::String
      }
    }
  };
}
